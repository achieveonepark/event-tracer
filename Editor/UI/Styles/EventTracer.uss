.et-root {
    flex-grow: 1;
    background-color: #383838;
    color: #d2d2d2;
    font-size: 12px;
    --et-panel: #383838;
    --et-border: #272727;
    --et-muted: #a0a0a0;
    --et-text: #d2d2d2;
    --et-selection: #3a5f85;
}
.et-root.light-theme {
    background-color: #c8c8c8;
    color: #202020;
    --et-panel: #c8c8c8;
    --et-border: #a0a0a0;
    --et-muted: #626262;
    --et-text: #202020;
    --et-selection: #7a9ab8;
}
.et-app-header { flex-direction: row; align-items: center; height: 25px; padding-left: 8px; padding-right: 8px; }
.et-wordmark { color: var(--et-text); -unity-font-style: bold; font-size: 11px; }
.et-header-hint { flex-grow: 1; -unity-text-align: middle-right; color: var(--et-muted); font-size: 10px; }
.et-session-bar { flex-direction: row; align-items: center; height: 44px; padding: 4px 8px; }
.et-session-title { font-size: 12px; color: var(--et-text); margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; }
.et-muted { color: var(--et-muted); font-size: 10px; }
.et-mode-badge { color: var(--et-text); padding: 3px 5px; font-size: 10px; margin-right: 7px; }
.et-mode-badge.is-muted { color: var(--et-muted); }
.et-record-toggle { margin-right: 7px; }
.et-button { height: 23px; margin-left: 2px; margin-right: 2px; border-radius: 2px; padding-left: 7px; padding-right: 7px; }
.et-button:disabled { opacity: 0.5; }
.et-filter-bar { flex-direction: row; align-items: center; padding: 7px 8px; }
.et-search { flex-grow: 1; flex-shrink: 1; min-width: 90px; width: auto; margin-right: 6px; }
.et-category-filter { width: 140px; margin-right: 4px; }
.et-level-filter { width: 105px; margin-right: 8px; }
.et-source-filter { width: 120px; margin-left: 6px; margin-right: 4px; }
.et-workspace { flex-grow: 1; border-top-width: 1px; border-top-color: var(--et-border); border-bottom-width: 1px; border-bottom-color: var(--et-border); }
.et-event-panel { flex-grow: 1; min-width: 550px; }
.et-column-header { flex-direction: row; align-items: center; height: 25px; color: var(--et-muted); font-size: 10px; padding-left: 8px; padding-right: 8px; border-bottom-width: 1px; border-bottom-color: var(--et-border); }
.et-time { width: 72px; flex-shrink: 0; }
.et-frame { width: 52px; flex-shrink: 0; color: var(--et-muted); }
.et-event-name { flex-grow: 1; flex-shrink: 1; min-width: 130px; overflow: hidden; flex-direction: row; align-items: center; }
.et-source { width: 110px; flex-shrink: 0; color: var(--et-muted); overflow: hidden; text-overflow: ellipsis; }
.et-event-list { flex-grow: 1; background-color: transparent; }
.et-event-row { flex-direction: row; align-items: center; height: 26px; padding-left: 8px; padding-right: 8px; color: var(--et-text); font-size: 11px; }
.et-event-list .unity-collection-view__item:hover, .et-event-list .unity-list-view__item:hover { background-color: rgba(128, 128, 128, 0.12); }
.et-event-list .unity-collection-view__item--selected, .et-event-list .unity-list-view__item--selected { background-color: var(--et-selection); }
.et-level-dot { font-size: 7px; color: #a8b6c4; width: 14px; flex-shrink: 0; }
.et-level-dot.is-warning, .et-muted.is-warning { color: #d5bf8c; }
.et-level-dot.is-error { color: #e3a0a0; }
.et-event-label { flex-grow: 1; overflow: hidden; text-overflow: ellipsis; }
.et-empty-events { flex-grow: 1; padding: 40px 16px; color: var(--et-muted); -unity-text-align: middle-center; white-space: normal; font-size: 11px; }
.et-detail-panel { min-width: 280px; border-left-width: 1px; border-left-color: var(--et-border); padding: 2px 10px 12px 10px; }
.et-eyebrow { margin-top: 13px; margin-bottom: 7px; font-size: 10px; color: var(--et-muted); -unity-font-style: bold; }
.et-detail-title { color: var(--et-text); font-size: 13px; -unity-font-style: bold; white-space: normal; }
.et-detail-meta { color: var(--et-muted); font-size: 10px; margin-top: 5px; white-space: normal; }
.et-detail-body { color: var(--et-muted); font-size: 11px; white-space: normal; margin-top: 3px; margin-bottom: 6px; }
.et-detail-panel .et-button { margin-top: 2px; margin-bottom: 2px; -unity-text-align: middle-left; overflow: hidden; text-overflow: ellipsis; }
.et-code { margin: 0; }
.et-code .unity-text-field__input { white-space: normal; border-radius: 2px; padding: 6px; font-size: 11px; }
.et-detail-empty { align-items: center; padding-top: 80px; }
.et-detail-empty .et-detail-title { font-size: 12px; -unity-text-align: middle-center; color: var(--et-muted); -unity-font-style: normal; }
.et-detail-empty .et-detail-body { margin-top: 8px; -unity-text-align: middle-center; }
.et-limits { padding: 6px 8px; color: var(--et-muted); font-size: 10px; }
.et-limits-row { flex-direction: row; flex-wrap: wrap; align-items: center; padding-top: 5px; }
.et-limits-row .unity-base-field { flex-grow: 1; margin-right: 8px; }
.et-limits-row .unity-base-field__label { min-width: 0; }
